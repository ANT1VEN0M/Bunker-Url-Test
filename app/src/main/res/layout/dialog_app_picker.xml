<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bunker_surface"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_dialog_title"
        android:textColor="@color/bunker_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/searchEditText"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bunker_card"
        android:hint="@string/search_hint"
        android:textColorHint="@color/bunker_text_muted"
        android:textColor="@color/bunker_text"
        android:textSize="13sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="text"
        android:maxLines="1"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/btnSelectAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/select_all"
            android:textColor="@color/bunker_red"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="6dp"
            android:background="@drawable/bunker_badge_outline"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btnClearAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/clear_all"
            android:textColor="@color/bunker_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="6dp"
            android:background="@drawable/bunker_badge_outline"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scrollbars="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/btn_cancel"
            android:textColor="@color/bunker_text_secondary"
            android:background="@drawable/bunker_button_secondary"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDialogSave"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/btn_save"
            android:textColor="@color/bunker_text"
            android:background="@drawable/bunker_button_primary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
