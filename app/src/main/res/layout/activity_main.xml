<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRoot"
    android:background="@color/bunker_bg"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true">
    <LinearLayout
        android:id="@+id/mainContentContainer"
        android:orientation="vertical"
        android:paddingTop="@dimen/bunker_space_lg"
        android:paddingBottom="@dimen/bunker_space_xxl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/bunker_screen_padding"
        android:paddingEnd="@dimen/bunker_screen_padding">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/mascot1"
                android:scaleType="fitCenter"
                android:contentDescription="Кот Антидот"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/bunker_space_md">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/bunker_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BUNKER URL TEST"
                    android:letterSpacing="0.025"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/bunker_text_muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="LIVE NETWORK MONITOR"
                    android:letterSpacing="0.12"/>
            </LinearLayout>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/bunker_red"
                android:background="@drawable/bunker_badge_outline"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:letterSpacing="0.08"/>
        </LinearLayout>
        <TextView
            android:id="@+id/summary"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/bunker_text_muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bunker_section_gap"
            android:text="ПРОВЕРКА ПРИЛОЖЕНИЙ"
            android:letterSpacing="0.1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bunker_text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bunker_space_xs"
            android:text="Выбери установленные приложения. Известные адреса проверяются напрямую, предполагаемые помечаются знаком ≈."
            android:lineSpacingExtra="3dp"/>
        <Button
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bunker_text"
            android:id="@+id/appsButton"
            android:background="@drawable/bunker_button_secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bunker_touch_target"
            android:layout_marginTop="@dimen/bunker_space_md"
            android:text="ВЫБРАТЬ ПРИЛОЖЕНИЯ"
            android:textAllCaps="false"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/appsResults"
            android:background="@drawable/bunker_card"
            android:padding="@dimen/bunker_space_sm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bunker_space_sm"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/bunker_text_muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bunker_section_gap"
            android:text="МОНИТОРИНГ СЕРВИСОВ"
            android:letterSpacing="0.1"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/results"
            android:background="@drawable/bunker_card"
            android:padding="@dimen/bunker_space_sm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bunker_space_sm"/>
        <Button
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bunker_text"
            android:id="@+id/auditButton"
            android:background="@drawable/bunker_button_primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bunker_touch_target"
            android:layout_marginTop="@dimen/bunker_space_md"
            android:text="◉  АУДИТ АДРЕСОВ"
            android:textAllCaps="false"/>
        <Button
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bunker_text"
            android:id="@+id/checkButton"
            android:background="@drawable/bunker_button_primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bunker_touch_target"
            android:layout_marginTop="@dimen/bunker_space_sm"
            android:text="ОСТАНОВИТЬ ПРОВЕРКУ"
            android:textAllCaps="false"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/bunker_text_secondary"
            android:id="@+id/customButton"
            android:background="@drawable/bunker_button_secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bunker_touch_target"
            android:layout_marginTop="@dimen/bunker_space_sm"
            android:text="＋  ДОБАВИТЬ СЕРВИС"
            android:textAllCaps="false"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/bunker_text_secondary"
            android:id="@+id/restoreButton"
            android:background="@drawable/bunker_button_secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bunker_touch_target"
            android:layout_marginTop="@dimen/bunker_space_sm"
            android:text="↶  ВЕРНУТЬ СТАНДАРТНЫЕ"
            android:textAllCaps="false"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/bunker_text_muted"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bunker_space_lg"
            android:text="Проверка каждые 15 секунд · Автоподбор доменов — оценка, а не гарантия работы приложения."
            android:lineSpacingExtra="3dp"/>
    </LinearLayout>
</ScrollView>
